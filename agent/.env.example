# Ollama 연결 (로컬 — 임베딩 bge-m3 전용)
OLLAMA_BASE_URL=http://localhost:11434

# 생성 옵션 (NIM 생성에 사용)
AGENT_TEMPERATURE=0.1
AGENT_NUM_PREDICT=1024

# FastAPI
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# 임베딩 · 벡터스토어
EMBED_MODEL=bge-m3
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=minsa_legal

# 생성 LLM (클라우드 NVIDIA NIM · OpenAI 호환)
# 주의: pydantic은 인라인 '#' 주석을 안 벗긴다 → 키는 값만, 뒤에 주석 붙이지 말 것
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_API_KEY=

# 관측성 (LangSmith 개발 트레이싱)
# 켜려면 LANGSMITH_TRACING=true + 아래 키 입력. 키는 값만(주석 X).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=marketon-legal-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
