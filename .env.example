# dev(매일 개발) 전용 환경변수. `cp .env.example .env` 후 그대로도 로컬에서 동작한다.
#   전체 컨테이너 배포는 infra/onprem/.env.example · infra/cloud/*/.env.example 참고.
# .env 는 gitignore. 아래 DB 기본값은 로컬 dev용 — 운영 값은 절대 여기 두지 않는다.
# --- Database (MySQL) — 루트 docker-compose.yml·앱 기본값과 일치 ---
MYSQL_ROOT_PASSWORD=root1234
DB_USERNAME=dongne
DB_PASSWORD=dongne1234
# --- App (JWT_SECRET은 미설정 시 로컬 개발용 기본값 사용, 운영은 반드시 교체) ---
JWT_SECRET=please-change-this-to-a-long-random-secret-string
# --- Mail (이메일 인증/비밀번호 재설정 발송. 메일 기능 쓸 때만 채운다) ---
MAIL_USERNAME=your-smtp-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password-without-spaces
# --- File Storage (dev는 local = 호스트 ./uploads. s3는 온프레미스/클라우드에서) ---
FILE_STORAGE_TYPE=local
# --- 소셜 로그인 (카카오/구글). 미설정 시 빈 값으로 기동은 되지만 실제 로그인은 안 된다 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# --- AI (Ollama, dev는 컨테이너로 자동 기동. 아래는 pull·백엔드 공용 모델 knob) ---
# 주석 해제 시 컨테이너가 받는 모델과 백엔드가 호출하는 모델이 함께 바뀐다. 미설정이면 qwen3:1.7b.
# OLLAMA_MODEL=qwen3:1.7b
