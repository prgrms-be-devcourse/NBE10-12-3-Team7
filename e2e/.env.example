# 이 파일을 .env 로 복사해서 쓴다. 기본값 그대로면 복사하지 않아도 동작한다.
# 포트는 dev 환경(8080/3000/3306/6379)과 어긋나 있다 — 개발 서버를 켜둔 채로 e2e 를 돌릴 수 있다.

# 백엔드 컨테이너
E2E_BACKEND_URL=http://localhost:18080

# 프론트엔드 컨테이너 — specs/ui 에서만 쓴다 (--profile ui 로 기동)
E2E_FRONTEND_URL=http://localhost:13000

# 이메일 인증 코드를 꺼내오는 Redis
E2E_REDIS_URL=redis://localhost:6380

# Mailpit — 발송된 메일 확인. 같은 주소가 웹 UI 다.
E2E_MAILPIT_URL=http://localhost:8025

# 호스트에서 ./gradlew bootRun 으로 띄운 백엔드를 대신 쓰고 싶을 때:
#   E2E_BACKEND_URL=http://localhost:8080
