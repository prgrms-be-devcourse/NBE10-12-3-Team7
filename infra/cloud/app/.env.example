# EC2 #1 (app) 배포용. 실제 값은 .env 로 복사(gitignore). 이 파일은 키 목록.
# --- ECR ---
ECR_REGISTRY=<AWS계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
# 수동 실행 시 fallback. 자동 배포(CD)는 커밋 SHA로 덮어써 결정적으로 배포한다.
# 롤백은 이 값을 이전 SHA로 두고 `docker compose --env-file .env pull && up -d`.
IMAGE_TAG=latest
# --- DB (RDB EC2의 MySQL) ---
DB_URL=jdbc:mysql://<RDB-프라이빗IP>:3306/dongne_market?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=dongne
DB_PASSWORD=changeme
# --- App ---
JWT_SECRET=please-change-to-a-long-random-secret-string
# --- AI (Ollama) — 이 EC2에 co-locate된 컨테이너 사용. 주소는 compose에 고정(ollama:11434) ---
# 모델 기본값은 qwen3:1.7b. 바꾸려면 아래 주석 해제(pull·백엔드 공용 knob).
# OLLAMA_MODEL=qwen3:1.7b
# --- Mail (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<gmail-주소>
MAIL_PASSWORD=<gmail-앱-비밀번호>
# --- 소셜 로그인 (카카오/구글). redirect URI는 각 콘솔에 등록한 프론트엔드 도메인과 일치해야 한다 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<프론트엔드-도메인>/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<프론트엔드-도메인>/oauth/google/callback
