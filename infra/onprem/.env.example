# 온프레미스 전체 스택 배포용. 실제 값은 .env 로 복사(gitignore). 이 파일은 "필요한 키" 목록.
# --- Database (스택 내 MySQL 컨테이너) ---
MYSQL_ROOT_PASSWORD=changeme-root
DB_USERNAME=dongne
DB_PASSWORD=changeme-db
# --- 이미지 레지스트리 (Zot). app/next 이미지를 여기서 pull한다 ---
IMAGE_REGISTRY=localhost:5000
IMAGE_TAG=latest
# --- App ---
JWT_SECRET=please-change-this-to-a-long-random-secret-string
# --- AI (Ollama) — 스택 내 컨테이너 사용. 주소는 compose에 고정(ollama:11434). 모델 기본 qwen3:1.7b ---
# OLLAMA_MODEL=qwen3:1.7b
# --- 파일 저장소 (기본 local = 볼륨 디스크. S3 쓰려면 s3 + 아래 AWS 값·자격증명) ---
FILE_STORAGE_TYPE=s3
AWS_S3_BUCKET=marketon-images
AWS_REGION=us-east-1
# 값이 있으면 S3 호환(RustFS) 경로, 비우면 실제 AWS S3 경로로 분기한다
FILE_STORAGE_S3_ENDPOINT=http://rustfs:9000
# --- 오브젝트 스토리지 (RustFS). S3 호환 — 클라우드의 S3 대응 ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=changeme-rustfs
# --- 앱 자원. 힙은 mem_limit의 비율로 잡힌다(고정 -Xmx 아님) ---
APP_MEM_LIMIT=2g
# APP_JAVA_OPTS=-XX:InitialRAMPercentage=50 -XX:MaxRAMPercentage=75
# --- Mail (이메일 인증 / 비밀번호 재설정 발송용 SMTP 계정) ---
MAIL_USERNAME=your-smtp-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password-without-spaces
# --- 소셜 로그인 (카카오/구글). redirect URI는 각 콘솔에 등록한 프론트엔드 도메인과 일치해야 한다 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<프론트엔드-도메인>/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<프론트엔드-도메인>/oauth/google/callback
# --- CI/CD (Jenkins, cicd 프로파일) ---
# Jenkins가 추적할 브랜치. 검증 중에는 feat 브랜치, 머지 후 develop으로 되돌린다
JENKINS_TRACK_BRANCH=develop
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme-jenkins
# 호스트의 리포 절대경로. Jenkins 배포 단계가 이 경로의 compose 파일·.env를 사용한다.
HOST_REPO_PATH=/absolute/path/to/NBE10-12-3-Team7
# --- Monitoring (observability 프로파일에서만) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# --- [임시] Kotlin 전환 중 스키마 우회 (기본 validate). 마이그레이션 정리되면 이 키 삭제 ---
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
