# 부하를 거는 노트북에서 쓰는 설정. cp .env.example .env 후 값을 채운다(.env 는 커밋 금지).

# 맥의 LAN IP. 맥에서 `ipconfig getifaddr en0` 으로 확인한다.
# ⚠️ 공유기가 DHCP 로 주소를 바꿀 수 있고, 유선으로 전환하면 인터페이스가 달라져 IP 도 바뀐다.
#    실제로 2026-08-04 에 192.168.219.x → 192.168.200.x 로 대역째 바뀐 적이 있다.
#    **회차 전에 반드시 재확인할 것.**
BASE_URL=http://192.168.200.167

# k6 결과를 맥의 Prometheus 로 밀어넣는다. 비워두면 터미널 요약만 나온다.
# 이 값을 채웠다면 실행할 때 -o experimental-prometheus-rw 를 붙여야 실제로 전송된다.
K6_PROMETHEUS_RW_SERVER_URL=http://192.168.200.167:9090/api/v1/write

# 실행 구분용 꼬리표. Grafana 에서 회차를 나눠 보려면 매번 다르게 준다.
# ⚠️ k6 는 이 값을 맵으로 파싱한다 — 구분자는 `=` 가 아니라 `:` 다(`key:value,key2:value2`).
K6_TAGS=testid:run-1

# 시드 계정(load-*@loadtest.local) 비밀번호. 로그인 회차(LOGIN=true)에서만 쓴다.
# **비워 두고 맥 담당자에게 별도로 받는다.** 이 리포는 public 이고, 시드 계정은 관리자 계정
# 해시를 복사해 만들어져서 여기 적으면 기존 노출을 한 번 더 늘린다.
LOGIN_PASSWORD=
