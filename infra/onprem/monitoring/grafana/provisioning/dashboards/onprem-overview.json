{
  "uid": "onprem-overview",
  "title": "온프레미스 종합 — 앱 · 컨테이너 · DB · 하드웨어",
  "description": "위에서 아래로 훑으며 확인한다. ① 서비스가 건강한가 → ② 컨테이너가 자원에 눌렸나 → ③ DB가 병목인가 → ④ VM 자원이 남는가",
  "tags": [
    "onprem",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "① 앱 — 서비스가 건강한가",
      "description": "",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "요청률 (엔드포인트별)",
      "description": "초당 요청 수. 부하가 실제로 들어오는지 먼저 여기서 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "응답시간 평균 · 최대",
      "description": "서버가 실제로 처리한 시간. Spring Boot는 히스토그램 버킷을 기본으로 내보내지 않아 p95/p99는 서버측에서 계산할 수 없다 — 백분위는 k6(클라이언트측) 대시보드에서 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "평균 (전체)",
          "expr": "sum(rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])), 0.001)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "평균 {{uri}}",
          "expr": "sum(rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[1m])) by (uri) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) by (uri), 0.001)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "최대 {{uri}}",
          "expr": "max(http_server_requests_seconds_max{uri=~\"/api/.*\"}) by (uri)"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "에러율 (5xx 비율)",
      "description": "깨지고 있는지. 트래픽이 없을 때도 0으로 표시된다(빈 화면과 정상 0을 구분하기 위해).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count[1m])) or vector(1))",
          "legendFormat": "5xx 비율",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "JVM 힙 · DB 커넥션 풀",
      "description": "힙은 왼쪽 축(바이트), 커넥션 수는 오른쪽 축(개). 힙이 상한에 붙거나 커넥션이 최대치에 붙으면 응답이 밀린다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "커넥션.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "커넥션 수"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "힙 사용",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "힙 상한",
          "expr": "max(jvm_memory_max_bytes{area=\"heap\"})"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "커넥션 활성",
          "expr": "hikaricp_connections_active"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "커넥션 최대",
          "expr": "hikaricp_connections_max"
        }
      ]
    },
